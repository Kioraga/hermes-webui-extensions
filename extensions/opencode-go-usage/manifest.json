{
  "extensions": [
    {
      "id": "opencode-go-usage",
      "name": "OpenCode Go Usage",
      "description": "OpenCode Go plan windows (rolling / weekly / monthly) in a composer chip + popover panel.",
      "scripts": [
        "assets/opencode-go-usage.js"
      ],
      "stylesheets": [
        "assets/opencode-go-usage.css"
      ],
      "permissions": {
        "storage": {
          "owned": true
        }
      },
      "settings_schema": [
        {
          "key": "auto_refresh",
          "type": "boolean",
          "label": "Refresh automatically while the panel is open",
          "default": true
        },
        {
          "key": "refresh_seconds",
          "type": "integer",
          "label": "Refresh interval (seconds)",
          "default": 60
        }
      ],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:17799",
        "health_path": "/health",
        "proxy_auth": "token-v1"
      }
    }
  ]
}